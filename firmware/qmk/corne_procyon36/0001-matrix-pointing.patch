+#else
+#    define MP_SIG_MATRIX 0
+#endif
+#define MP_LAYOUT_SIG ((uint16_t)(0x4C00 ^ (MP_SIG_LAYERS << 10) ^ MP_SIG_MATRIX ^ (MP_SIG_MACROS << 3) ^ (MP_SIG_ENCODERS << 13) ^ (EECONFIG_USER_DATA_SIZE >> 4)))

+#define MP_EDGE_COUNT 4   // left, right, top, bottom (as the user sees the pad)
+#define MP_CORNER_COUNT 4 // top-left, top-right, bottom-left, bottom-right
+#define MP_KNOB_COUNT 2
+#define MP_EXT_MAGIC 0x4D5A // 'MZ'
